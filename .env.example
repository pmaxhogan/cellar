# Cellar configuration. Copy to .env and fill in. .env is gitignored; this repo
# is public, so never commit real values. Only deployment fundamentals live
# here; everything else is a setting managed in the UI.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
# Ignored (forced to 127.0.0.1) whenever INSECURE_ALLOW_PUBLIC_ACCESS is on.
HOST=0.0.0.0
# Durable state: state DB, logs, downloaded tool binaries, per-video metadata
# (info json, captions, thumbnails). Not counted against any storage quota.
DATA_DIR=/data
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public origin, no trailing slash. Used for OAuth redirects and share URLs.
PUBLIC_ORIGIN=https://cellar.example.com

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# AES-256-GCM key for stored OAuth refresh tokens, cookie jars and proxy URLs.
# Exactly 64 hex characters. Generate with: openssl rand -hex 32
# Losing this makes every stored secret unrecoverable.
CELLAR_SECRET_KEY=

# ---------------------------------------------------------------------------
# Authentication (Cloudflare Access)
# ---------------------------------------------------------------------------
# Cellar refuses to start unless all three are set or INSECURE_ALLOW_PUBLIC_ACCESS=1.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Google (YouTube Data API v3 OAuth client, "Web application")
# ---------------------------------------------------------------------------
# Redirect URI to register: $PUBLIC_ORIGIN/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# yt-dlp helpers
# ---------------------------------------------------------------------------
# PO-token provider (bgutil-ytdlp-pot-provider sidecar). Overridable in the UI.
POT_PROVIDER_URL=http://bgutil:4416

# ---------------------------------------------------------------------------
# GPU (passed through by the compose file; harmless when absent)
# ---------------------------------------------------------------------------
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=video,compute,utility

# ---------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------
# Set to 1 to run with NO authentication. Cellar then binds 127.0.0.1 only,
# logs a warning banner every 10 minutes and shows a red banner in the UI.
#INSECURE_ALLOW_PUBLIC_ACCESS=1
